fn sumTo(n: int) -> int {
    let s = 0
    for (let i = 1; i <= n; i = i + 1) {
        s = s + i
    }
    return s
}

fn printMultTable(n: int) {
    for (let i = 1; i <= n; i = i + 1) {
        for (let j = 1; j <= n; j = j + 1) {
            print(i * j)
        }
    }
}

// Count up and down
for (let i = 1; i <= 5; i = i + 1) {
    print(i)
}

// Triangular numbers
print(sumTo(10))
print(sumTo(100))
